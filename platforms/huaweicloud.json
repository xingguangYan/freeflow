{
  "id": "huaweicloud",
  "name": "华为云开发者联盟",
  "hostText": "huaweicloud.com",
  "editorUrl": "https://bbs.huaweicloud.com/blogs/article",
  "editorKernel": "iframe-contenteditable",
  "contentEditable": true,
  "contentSelectors": ["body[contenteditable=\"true\"]", ".ql-editor", ".ProseMirror", ".CodeMirror", "textarea"],
  "contentFillMethod": "insert-text",
  "contentIframe": "iframe",
  "titleSelectors": ["input[placeholder*=\"标题\"]", "input[name=\"title\"]", "textarea[placeholder*=\"标题\"]"],
  "titleInputType": "input",
  "coverSelectors": ["input[type=\"file\"][accept*=\"image\"]", "input[type=\"file\"]"],
  "tagSelectors": ["input[placeholder*=\"标签\"]"],
  "publishSelectors": ["button:has-text(\"提交\")", "button:has-text(\"发表\")"],
  "publishTexts": ["发布", "提交"],
  "dialogTexts": ["确定", "继续发布"],
  "loginSuccessSelectors": ["button:has-text(\"写博客\")", "button:has-text(\"发表\")", "input[placeholder*=\"标题\"]"],
  "loginUrl": "https://bbs.huaweicloud.com/",
  "loggedInUrl": "/bbs\\.huaweicloud\\.com\\/(blogs|usercenter)/",
  "agreementCheckboxId": "agreementBox",
  "twoTextboxTrap": true,
  "preferMarkdownMode": true,
  "noDirectApi": false,
  "note": "正文在 iframe 内 body[contenteditable=true]，先 frame_locator 切 iframe；编辑器内存在两个 textbox，需粘贴到使“统计字数”>0 的那个；发布前必须勾选 id=agreementBox 否则仅存草稿；优先走 Markdown 源码编辑模式。"
}
