{
  "id": "c51cto",
  "name": "51CTO博客",
  "hostText": "51cto.com",
  "editorUrl": "https://blog.51cto.com/blogger/publish",
  "editorKernel": "plain-textarea",
  "contentEditable": false,
  "contentSelectors": ["textarea[placeholder=\"请输入正文\"]", "textarea[placeholder*=\"正文\"]", "textarea[placeholder*=\"内容\"]", "textarea"],
  "contentFillMethod": "set-value",
  "titleSelectors": ["#title", "input[placeholder*=\"标题\"]", "textarea[placeholder*=\"标题\"]", "input[name=\"title\"]"],
  "titleInputType": "input",
  "coverSelectors": ["input[type=\"file\"][accept*=\"image\"]", "input[type=\"file\"]"],
  "tagSelectors": ["input[placeholder*=\"标签\"]", "input[placeholder*=\"添加标签\"]"],
  "publishSelectors": ["button:has-text(\"发表\")"],
  "publishTexts": ["发布", "发表"],
  "dialogTexts": ["确定", "继续发布"],
  "loginSuccessSelectors": ["#title", "textarea[placeholder=\"请输入正文\"]", "button:has-text(\"发表\")"],
  "loginUrl": "https://blog.51cto.com/",
  "loggedInUrl": "/blog\\.51cto\\.com/",
  "draftSavedSignal": "草稿已保存",
  "publishClickMethod": "pointer-events",
  "noDirectApi": false,
  "note": "标题 id=\"title\" 稳定；正文是普通 textarea（placeholder“请输入正文”），可直接 set_value；带图片内容后会触发草稿保存与图片解析，需等“草稿已保存”或“发表按钮可点”再发布；发表按钮用 pointer-events 模拟点击，避免直接 .click() 被拦截。"
}
